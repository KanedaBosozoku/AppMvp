      //  "Name": "Seq",
      //  "Args": { "serverUrl": "${SEQ_URL}" }
      //},
      //{
      //  "Name": "Sentry",
      //  "Args": { "dsn": "${SENTRY_DSN}" }
      //}
    ]
  }
}
